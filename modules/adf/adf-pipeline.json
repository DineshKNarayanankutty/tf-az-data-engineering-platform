{
  "name": "pl_ingest_transform_publish",
  "properties": {
    "activities": [
      {
        "name": "Copy_To_Bronze",
        "type": "Copy",
        "dependsOn": [],
        "policy": { "timeout": "0.12:00:00", "retry": 2, "retryIntervalInSeconds": 30 },
        "typeProperties": {
          "source": { "type": "BinarySource" },
          "sink": { "type": "BinarySink" }
        }
      },
      {
        "name": "Run_Databricks_Notebook",
        "type": "DatabricksNotebook",
        "dependsOn": [{ "activity": "Copy_To_Bronze", "dependencyConditions": ["Succeeded"] }],
        "linkedServiceName": {
          "referenceName": "ls_databricks_mi",
          "type": "LinkedServiceReference"
        },
        "typeProperties": {
          "notebookPath": "/Shared/pipelines/bronze_to_silver_gold",
          "baseParameters": {
            "environment": "@pipeline().parameters.environment"
          }
        }
      }
    ],
    "parameters": {
      "environment": { "type": "String" }
    }
  }
}
