{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "factoryName": { "type": "string" },
    "datasetDefinition": { "type": "object" },
    "pipelineDefinition": { "type": "object" }
  },
  "resources": [
    {
      "type": "Microsoft.DataFactory/factories/datasets",
      "apiVersion": "2018-06-01",
      "name": "[concat(parameters('factoryName'), '/', parameters('datasetDefinition').name)]",
      "properties": "[parameters('datasetDefinition').properties]"
    },
    {
      "type": "Microsoft.DataFactory/factories/pipelines",
      "apiVersion": "2018-06-01",
      "name": "[concat(parameters('factoryName'), '/', parameters('pipelineDefinition').name)]",
      "properties": "[parameters('pipelineDefinition').properties]"
    }
  ]
}
